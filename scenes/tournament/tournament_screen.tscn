[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/tournament/tournament_screen.gd" id="1_screen"]
[ext_resource type="Script" path="res://scenes/tournament/draw/draw_bracket.gd" id="2_bracket"]
[ext_resource type="PackedScene" path="res://scenes/tournament/draw/match_card.tscn" id="3_card"]
[ext_resource type="PackedScene" path="res://scenes/tournament/draw/champion_card.tscn" id="4_champion"]
[ext_resource type="PackedScene" path="res://scenes/tournament/draw/head_to_head_card.tscn" id="5_h2h"]
[ext_resource type="PackedScene" path="res://scenes/tournament/draw/player_profile_card.tscn" id="6_profile"]
[ext_resource type="PackedScene" path="res://scenes/tournament/draw/news_item.tscn" id="7_news"]
[ext_resource type="Texture2D" path="res://addons/at-icons/control/arrow_left.svg" id="8_left"]
[ext_resource type="Texture2D" path="res://addons/at-icons/control/arrow_right.svg" id="9_right"]

[sub_resource type="ButtonGroup" id="round_group"]
allow_unpress = false

[node name="TournamentScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_screen")
match_scene_path = "res://scenes/match/tennis_match.tscn"
news_item_scene = ExtResource("7_news")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.141, 0.102, 0.188, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 28

[node name="Columns" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="Main" type="VBoxContainer" parent="Margin/Columns"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="Header" type="PanelContainer" parent="Margin/Columns/Main"]
layout_mode = 2

[node name="HeaderRow" type="HBoxContainer" parent="Margin/Columns/Main/Header"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Badge" type="PanelContainer" parent="Margin/Columns/Main/Header/HeaderRow"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
theme_type_variation = &"TournamentBadge"

[node name="BadgeText" type="VBoxContainer" parent="Margin/Columns/Main/Header/HeaderRow/Badge"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = -4

[node name="BadgeNameLabel" type="Label" parent="Margin/Columns/Main/Header/HeaderRow/Badge/BadgeText"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"InkLabel"
theme_override_font_sizes/font_size = 28
text = "US OPEN"
horizontal_alignment = 1

[node name="BadgeCategoryLabel" type="Label" parent="Margin/Columns/Main/Header/HeaderRow/Badge/BadgeText"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"InkLabel"
theme_override_font_sizes/font_size = 14
text = "GRAND SLAM"
horizontal_alignment = 1

[node name="Info" type="VBoxContainer" parent="Margin/Columns/Main/Header/HeaderRow"]
layout_mode = 2
size_flags_horizontal = 3
alignment = 1
theme_override_constants/separation = 2

[node name="TitleRow" type="HBoxContainer" parent="Margin/Columns/Main/Header/HeaderRow/Info"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="StateBadge" type="PanelContainer" parent="Margin/Columns/Main/Header/HeaderRow/Info/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"BadgeRed"

[node name="StateLabel" type="Label" parent="Margin/Columns/Main/Header/HeaderRow/Info/TitleRow/StateBadge"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BoldLabel"
theme_override_font_sizes/font_size = 16
text = "LIVE"

[node name="TitleLabel" type="Label" parent="Margin/Columns/Main/Header/HeaderRow/Info/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BoldLabel"
theme_override_font_sizes/font_size = 34
text = "US Open"

[node name="InfoLabel" type="Label" parent="Margin/Columns/Main/Header/HeaderRow/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 18
text = "New York, USA  |  Men's Singles  |  128 players"

[node name="StatusLabel" type="Label" parent="Margin/Columns/Main/Header/HeaderRow/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.714, 0.196, 1)
theme_override_font_sizes/font_size = 22
autowrap_mode = 3

[node name="RoundBar" type="HBoxContainer" parent="Margin/Columns/Main"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="PrevRoundButton" type="Button" parent="Margin/Columns/Main/RoundBar"]
