[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/tournament/draw/draw_player_line.gd" id="1_line"]
[ext_resource type="PackedScene" path="res://scenes/tournament/draw/set_score.tscn" id="2_set"]
[ext_resource type="PackedScene" path="res://scenes/tournament/draw/player_avatar.tscn" id="3_avatar"]
[ext_resource type="PackedScene" path="res://scenes/tournament/draw/country_flag.tscn" id="4_flag"]
[ext_resource type="Texture2D" path="res://addons/at-icons/control/checkmark.svg" id="5_check"]

[node name="DrawPlayerLine" type="Button"]
custom_minimum_size = Vector2(0, 44)
theme_type_variation = &"DrawLine"
toggle_mode = true
script = ExtResource("1_line")
set_score_scene = ExtResource("2_set")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 6.0
offset_top = 4.0
offset_right = -6.0
offset_bottom = -4.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="PlayerAvatar" parent="Row" instance=ExtResource("3_avatar")]
unique_name_in_owner = true
layout_mode = 2

[node name="CountryFlag" parent="Row" instance=ExtResource("4_flag")]
unique_name_in_owner = true
layout_mode = 2

[node name="NameArea" type="Control" parent="Row"]
clip_contents = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="NameRow" type="HBoxContainer" parent="Row/NameArea"]
layout_mode = 1
anchors_preset = 9
anchor_bottom = 1.0
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="NameLabel" type="Label" parent="Row/NameArea/NameRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "C. Alcaraz"
vertical_alignment = 1

[node name="SeedLabel" type="Label" parent="Row/NameArea/NameRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "(1)"
vertical_alignment = 1

[node name="Check" type="TextureRect" parent="Row/NameArea/NameRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(18, 18)
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("5_check")
expand_mode = 1
stretch_mode = 5

[node name="Sets" type="HBoxContainer" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4
