theme_override_font_sizes/font_size = 18
text = "Into the R16  (3-0)"
horizontal_alignment = 2
autowrap_mode = 3

[node name="Separator" type="HSeparator" parent="Content"]
layout_mode = 2

[node name="PathTitleLabel" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 18
text = "Path"

[node name="PathRows" type="VBoxContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
