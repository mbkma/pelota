[sub_resource type="Resource" id="Control_0"]
script = ExtResource("2_control")
description = "Move"
keyboard_icons = Array[Texture2D]([ExtResource("3_res"), ExtResource("4_res"), ExtResource("5_res"), ExtResource("6_res")])
gamepad_icons = Array[Texture2D]([ExtResource("7_res")])

[sub_resource type="Resource" id="Control_4"]
script = ExtResource("2_control")
description = "Confirm in menus"
keyboard_icons = Array[Texture2D]([ExtResource("14_res")])
gamepad_icons = Array[Texture2D]([ExtResource("9_res")])

[sub_resource type="Resource" id="Page_0"]
script = ExtResource("1_page")
title = "Welcome to Pelota"
text = "Win points by hitting the ball into your opponent's court so that they cannot return it. Play against the CPU or against a friend.

In the player selection, move your keyboard or controller to the left or right to take that player, pick your character with up and down and confirm. A player without a device is played by the CPU."
image = ExtResource("20_res")
controls = Array[ExtResource("2_control")]([SubResource("Control_0"), SubResource("Control_4")])

[sub_resource type="Resource" id="Page_1"]
script = ExtResource("1_page")
title = "Movement & positioning"
text = "Run with the direction keys or the left stick. When your opponent hits, a blue ring shows the ideal spot to meet the ball.

Get there early: once you press a shot button your player only shuffles slowly towards the ball. Balls met off the racket's sweet spot lose pace and accuracy."
image = ExtResource("21_res")
controls = Array[ExtResource("2_control")]([SubResource("Control_0")])

[sub_resource type="Resource" id="Control_1"]
script = ExtResource("2_control")
description = "Topspin shot / flat serve"
keyboard_icons = Array[Texture2D]([ExtResource("8_res")])
gamepad_icons = Array[Texture2D]([ExtResource("9_res")])

[sub_resource type="Resource" id="Control_2"]
script = ExtResource("2_control")
description = "Slice shot / slice serve"
keyboard_icons = Array[Texture2D]([ExtResource("10_res")])
gamepad_icons = Array[Texture2D]([ExtResource("11_res")])

[sub_resource type="Resource" id="Control_3"]
script = ExtResource("2_control")
description = "Drop shot / kick serve"
keyboard_icons = Array[Texture2D]([ExtResource("12_res")])
gamepad_icons = Array[Texture2D]([ExtResource("13_res")])

[sub_resource type="Resource" id="Page_2"]
script = ExtResource("1_page")
title = "Groundstrokes"
text = "Press a shot button when the ball comes towards you and steer the aim with the direction - it stays where you leave it. Hold the button to build power and release it just before the racket meets the ball.

The circle on your opponent's side shows where the ball can land. The better your timing, the smaller it gets; it turns gold for a perfect shot with extra pace and spin. A rating above your player tells you how you did."
image = ExtResource("22_res")
controls = Array[ExtResource("2_control")]([SubResource("Control_1"), SubResource("Control_2"), SubResource("Control_3")])

[sub_resource type="Resource" id="Page_3"]
script = ExtResource("1_page")
title = "Serve"
text = "Slide along the baseline with left and right. Press and hold a serve button and aim inside the service box: flat for pace, slice for a curving serve, kick for a safe, high-bouncing serve.

Release the button to toss the ball and press it again right before the racket meets the ball. The closer to contact, the faster and more precise the serve."
image = ExtResource("23_res")
controls = Array[ExtResource("2_control")]([SubResource("Control_1"), SubResource("Control_2"), SubResource("Control_3")])

[sub_resource type="Resource" id="Page_4"]
script = ExtResource("1_page")
title = "At the net"
text = "Close to the net, a ball you take before it bounces is volleyed automatically. The drop shot button plays a delicate drop volley that dies right behind the net.

Move forward after a strong shot to finish the point - but watch out for passing shots and lobs."
image = ExtResource("24_res")
controls = Array[ExtResource("2_control")]([SubResource("Control_3")])

[sub_resource type="Resource" id="Control_5"]
script = ExtResource("2_control")
description = "Match statistics"
keyboard_icons = Array[Texture2D]([ExtResource("15_res")])
gamepad_icons = Array[Texture2D]([ExtResource("16_res")])

[sub_resource type="Resource" id="Control_6"]
script = ExtResource("2_control")
