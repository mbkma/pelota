keyboard_icons = Array[Texture2D]([ExtResource("17_res")])
gamepad_icons = Array[Texture2D]([ExtResource("18_res")])

[sub_resource type="Resource" id="Control_7"]
script = ExtResource("2_control")
description = "Change split-screen layout"
keyboard_icons = Array[Texture2D]([ExtResource("19_res")])

[sub_resource type="Resource" id="Page_5"]
script = ExtResource("1_page")
title = "During the match"
text = "Big points like break points and set points add pressure - it lowers your precision, the calmer players cope better. Running drains stamina, which costs speed and accuracy. Keep an eye on the panels in the corners.

Long rallies make the crowd go wild. Good luck!"
image = ExtResource("22_res")
controls = Array[ExtResource("2_control")]([SubResource("Control_5"), SubResource("Control_6"), SubResource("Control_7")])

